# Server Configuration
PORT=3000

# JWT Configuration
JWT_SECRET=change_this_to_a_strong_secret_in_production

# --- Database ---
# Set USE_DOCKER=false to use your local MySQL (default)
# Set USE_DOCKER=true  to connect to the Docker PostgreSQL container (npm run pg)
USE_DOCKER=false

# Local MySQL defaults (used when USE_DOCKER=false)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=tpnest

# Docker PostgreSQL defaults (used when USE_DOCKER=true)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=tpnest
